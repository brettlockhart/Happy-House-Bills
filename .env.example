# Happy House Bills — Environment Variables

## Clerk (Authentication)
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NUXT_CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

## Convex (Backend)
CONVEX_URL=
CONVEX_DEPLOY_KEY=

## Stripe (Billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_UPGRADE_PRICE_ID=
STRIPE_LOCAL_MOCK=

## Resend (Transactional Email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

## App
NEXT_PUBLIC_APP_URL=https://app.happyhousebills.com

## Cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
RECEIPT_SIGNED_URL_TTL=3600
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

## OpenRouter LLM (OCR) — Phase 2
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_OCR_MODEL=
OPENROUTER_ZDR=

## Dev-only auth bypass (DO NOT enable in production)
NUXT_PUBLIC_AUTH_BYPASS=
NUXT_PUBLIC_AUTH_BYPASS_USER_ID=
NUXT_PUBLIC_AUTH_BYPASS_ORG_ID=
# Convex deployment env (set via Convex dashboard or `npx convex env set`): AUTH_BYPASS=1, AUTH_BYPASS_USER_ID, AUTH_BYPASS_ORG_ID

## CI/CD (GitHub Actions Secrets)
# CONVEX_DEPLOY_KEY — Convex deployment key for CI/CD pipeline
